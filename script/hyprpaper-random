#!/usr/bin/env bash
set -euo pipefail

dotfiles_path="${DOTFILES_PATH:-$HOME/.local/share/dotfiles}"
wallpaper_dir="$dotfiles_path/wallpaper"
hyprpaper_config="/tmp/hyprpaper-random.conf"
log_file="/tmp/hyprpaper-random.log"

exec >>"$log_file" 2>&1
echo "[$(date '+%F %T')] choosing random wallpaper"

mapfile -t wallpapers < <(
  find "$wallpaper_dir" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
    | shuf
)

if ((${#wallpapers[@]} == 0)); then
  notify-send "hyprpaper" "No images found in $wallpaper_dir" 2>/dev/null || true
  exit 1
fi

wallpaper="${wallpapers[0]}"

mapfile -t monitors < <(hyprctl monitors | awk '/^Monitor / {print $2}')

if ((${#monitors[@]} == 0)); then
  monitors=("")
fi

{
  printf 'splash = false\n'
  printf 'ipc = off\n'
  for monitor in "${monitors[@]}"; do
    printf 'wallpaper = %s,%s,cover\n' "$monitor" "$wallpaper"
  done
} >"$hyprpaper_config"

pkill -x hyprpaper >/dev/null 2>&1 || true
nohup hyprpaper --config "$hyprpaper_config" >/tmp/hyprpaper.log 2>&1 &

notify-send "Wallpaper changed" "$(basename "$wallpaper")" 2>/dev/null || true
